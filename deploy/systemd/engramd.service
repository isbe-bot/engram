[Unit]
Description=ENGRAM local memory intelligence service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=engram
Group=engram
ExecStart=/usr/local/bin/engramd --config /etc/engram/engram.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/aileun /var/lib/engram /var/log/engram

[Install]
WantedBy=multi-user.target
